# Minimal Vector configuration — console output only
data_dir = "{{ vector_data_dir }}"

[api]
enabled = true
address = "127.0.0.1:{{ vector_api_port }}"

# Источник: читаем системные логи (syslog и auth.log)
[sources.system_logs]
type = "file"
include = [
  "/var/log/syslog",
  "/var/log/auth.log"
]
read_from = "end"
batch_size = 1024

# Приёмник: вывод всех логов в консоль в формате JSON
[sinks.console_output]
type = "console"
inputs = ["system_logs"]
encoding.codec = "json"
target = "stdout"
